# SignalWire Configuration
SPACE_NAME=your-space.signalwire.com
PROJECT_ID=your-project-id
AUTH_TOKEN=your-auth-token

# Flask Configuration. FLASK_DEBUG=True turns on the Werkzeug debugger (code
# execution from the browser) while the server listens on 0.0.0.0 -- leave it
# off unless you're debugging on a trusted network.
FLASK_DEBUG=False

# Server Configuration
PORT=5001

# CORS Configuration
FRONTEND_URL=http://localhost:5173

# Security: required to mint tokens; the /api/auth/token and /api/auth/refresh
# endpoints fail closed (503) if this is unset. Must match frontend/.env's
# VITE_DIALER_API_KEY.
DIALER_API_KEY=change-me
