# Must match backend/.env's DIALER_API_KEY. Sent as the X-API-Key header on
# token requests. Note: this is baked into the built JS bundle, so it is not a
# real secret in a public deployment — it only raises the bar against
# automated bots/scanners, paired with the backend's per-IP rate limit.
VITE_DIALER_API_KEY=change-me
